#!/bin/bash

set -eufo pipefail

{{ $brews := list
     "age"
     "bat"
     "btop"
     "croc"
     "curl"
     "dockutil"
     "eza"
     "fd"
     "ffmpeg"
     "fish"
     "fzf"
     "gdu"
     "gh"
     "git"
     "git-lfs"
     "gnu-units"
     "go"
     "golangci-lint"
     "jless"
     "jq"
     "neovim"
     "node"
     "pkg-config"
     "ripgrep"
     "shellcheck"
     "starship"
     "tmux"
     "wget"
     "xz"
     "yt-dlp"
     "zoxide" -}}
{{ $casks := list
     "balenaetcher"
     "firefox"
     "ghostty"
     "google-chrome"
     "google-earth-pro"
     "hot"
     "notunes"
     "steam"
     "tailscale-app"
     "transmission"
     "vagrant"
     "visual-studio-code"
     "vlc" -}}

brew bundle --file=/dev/stdin <<EOF
{{ range ($brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end -}}
{{ range ($casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end -}}
EOF
