#!/bin/bash

set -euo pipefail

# 普通用户通过 sudo 执行系统操作，root 用户直接执行。
run_as_root() {
    if (( EUID == 0 )); then
        "$@"
    else
        sudo "$@"
    fi
}

locale_gen_file=/etc/locale.gen
locale_conf_file=/etc/locale.conf

# 启用简体中文 UTF-8 locale，并生成对应的 locale 数据。
if ! run_as_root grep -Eq '^[[:space:]]*zh_CN\.UTF-8[[:space:]]+UTF-8([[:space:]]|$)' "$locale_gen_file"; then
    if run_as_root grep -Eq '^[[:space:]]*#[[:space:]]*zh_CN\.UTF-8[[:space:]]+UTF-8([[:space:]]|$)' "$locale_gen_file"; then
        run_as_root sed -i -E 's/^[[:space:]]*#[[:space:]]*(zh_CN\.UTF-8[[:space:]]+UTF-8).*$/\1/' "$locale_gen_file"
    else
        printf '%s\n' 'zh_CN.UTF-8 UTF-8' | run_as_root tee -a "$locale_gen_file" >/dev/null
    fi
fi
run_as_root locale-gen

# 仅设置系统默认语言，保留 locale.conf 中的其他变量。
if run_as_root test -f "$locale_conf_file"; then
    run_as_root sed -i '/^[[:space:]]*LANG=/d' "$locale_conf_file"
fi
printf '%s\n' 'LANG=zh_CN.UTF-8' | run_as_root tee -a "$locale_conf_file" >/dev/null
{{ end -}}
{{ end -}}
