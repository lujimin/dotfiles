{{ if eq .chezmoi.os "linux" -}}
{{ if eq .chezmoi.osRelease.id "arch" -}}
#!/bin/bash

set -euo pipefail

# AUR 打包不能以 root 运行，系统安装操作通过 sudo 提权。
if (( EUID == 0 )); then
    echo "请使用具有 sudo 权限的普通用户运行 chezmoi。" >&2
    exit 1
fi

packages=(
    base-devel
    bat
    btop
    chezmoi
    curl
    eza
    fd
    ffmpeg
    fish
    fzf
    git
    github-cli
    jless
    jq
    lazygit
    neovim
    nodejs
    oh-my-pi
    openai-codex
    opencode
    openssh
    paru
    pkgconf
    ripgrep
    shellcheck
    starship
    tmux
    tree-sitter-cli
    wget
    zoxide
)

# 读取 pacman 的有效配置，兼容通过 Include 引入的仓库，避免重复添加。
configured_repos="$(pacman-conf --repo-list)"
if ! grep -Fxq archlinuxcn <<< "$configured_repos"; then
    sudo tee -a /etc/pacman.conf >/dev/null <<'EOF'

[archlinuxcn]
Server = https://repo.archlinuxcn.org/$arch
EOF
fi

# 首次使用时，先信任签名密钥并安装密钥环。
if ! pacman -Q archlinuxcn-keyring >/dev/null 2>&1; then
    sudo pacman-key --lsign-key farseerfc@archlinux.org
    sudo pacman -Sy --needed --noconfirm archlinuxcn-keyring
fi

# 刷新软件包数据库、升级整个系统，并安装清单中的软件包。
sudo pacman -Syu --needed --noconfirm -- "${packages[@]}"

# 使用上游预编译二进制生成并安装 AUR 软件包，无需编译 Herdr 源码。
paru -S --needed --noconfirm herdr-bin

{{ end -}}
{{ end -}}
