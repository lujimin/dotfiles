{{ if eq .chezmoi.os "linux" -}}
{{ if eq .chezmoi.osRelease.id "arch" -}}
#!/bin/bash

set -euo pipefail

# 普通用户通过 sudo 执行系统操作，root 用户直接执行。
run_as_root() {
    if (( EUID == 0 )); then
        "$@"
    else
        sudo "$@"
    fi
}

packages=(
    bat
    btop
    chezmoi
    curl
    eza
    fd
    ffmpeg
    fish
    fzf
    git
    github-cli
    jless
    jq
    lazygit
    neovim
    nodejs
    oh-my-pi
    paru
    pkgconf
    ripgrep
    shellcheck
    starship
    tmux
    tree-sitter-cli
    wget
    zoxide
)

# 读取 pacman 的有效配置，兼容通过 Include 引入的仓库，避免重复添加。
configured_repos="$(pacman-conf --repo-list)"
if ! grep -Fxq archlinuxcn <<< "$configured_repos"; then
    run_as_root tee -a /etc/pacman.conf >/dev/null <<'EOF'

[archlinuxcn]
Server = https://repo.archlinuxcn.org/$arch
EOF
fi

# 首次使用时，先信任签名密钥并安装密钥环。
if ! pacman -Q archlinuxcn-keyring >/dev/null 2>&1; then
    run_as_root pacman-key --lsign-key farseerfc@archlinux.org
    run_as_root pacman -Sy --needed --noconfirm archlinuxcn-keyring
fi

# 刷新软件包数据库、升级整个系统，并安装清单中的软件包。
run_as_root pacman -Syu --needed --noconfirm -- "${packages[@]}"

{{ end -}}
{{ end -}}
